# Copy to .env (gitignored) only if you need it. The site itself needs no environment variables.

# Optional: a GitHub token (no scopes needed for public repos) for `npm run release:import -- latest`
# if you hit GitHub's unauthenticated API rate limit. Never commit a real token.
GITHUB_TOKEN=

# Optional: import releases from a different public repo than src/config/site.ts says.
ENGRAM_RELEASES_REPO=
