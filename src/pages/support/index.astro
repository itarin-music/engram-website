---
import Page from '../../layouts/Page.astro';
import ContactEmail from '../../components/ContactEmail.astro';
import Search from '../../components/Search.astro';
import { supportEmailSet } from '../../config/site';

type QA = { id: string; q: string; a: string };
const groups: { id: string; title: string; items: QA[] }[] = [
  {
    id: 'faq-general', title: 'About Engram', items: [
      { id: 'what', q: 'What is Engram?', a: 'A study app for your computer. You write notes, turn the important parts into flashcards, and Engram shows each card again just before you would forget it (spaced repetition). It also makes quizzes from your material, gives offline summaries of notes, has a code practice sandbox and study timers, and an optional AI tutor.' },
      { id: 'free', q: 'Is it really free?', a: 'Yes. Everything in Engram is free, including the AI tutor chat, with no trial, no limits and no ads. The one paid feature is Cloud backup: $5 a month, with the first month free.' },
      { id: 'account', q: 'Do I need an account?', a: 'No. Profiles in Engram are local workspaces on your computer, not online accounts. The only time you give an email address is if you subscribe to Cloud backup.' },
      { id: 'offline', q: 'Does it work offline?', a: 'Yes. Notes, cards, study, built-in quizzes, Explain, code practice, timers, imports and themes all work with no internet connection. The tutor works offline too if you use a local model with LM Studio or Ollama.' },
      { id: 'mobile', q: 'Is there a phone or tablet version?', a: 'Not as a download at the moment. Engram is a desktop app for Windows, macOS and Linux. Its code includes an installable web version for phones, but there is no public copy of it to install yet.' },
      { id: 'languages', q: 'Which subjects does it work for?', a: 'Any. It has extra templates for Japanese and programming, but nothing is tied to them. The app itself is in English.' },
    ],
  },
  {
    id: 'faq-install', title: 'Installing and updating', items: [
      { id: 'warning', q: 'Why does Windows or macOS warn me about Engram?', a: 'Engram\'s installers aren\'t code-signed yet, so your system doesn\'t recognise the publisher. The <a href="/download/#install">install steps</a> show how to continue safely, and you can <a href="/download/#verify">check the checksum</a> to confirm the file is genuine.' },
      { id: 'update', q: 'How do I update?', a: 'Download the newest version and install it over the old one. Engram doesn\'t update itself. Your notes and cards are kept. See <a href="/download/#update">Update Engram</a>.' },
      { id: 'which-mac', q: 'Which Mac download do I need?', a: 'Open the Apple menu and choose About This Mac. If it lists a "Chip" such as Apple M1 or M2, pick Apple Silicon. If it lists an Intel "Processor", pick Intel.' },
      { id: 'uninstall', q: 'Will uninstalling delete my notes?', a: 'No. Your notes and cards live in your vault folders, which uninstalling never touches. See <a href="/download/#uninstall">Uninstall Engram</a>.' },
    ],
  },
  {
    id: 'faq-data', title: 'Your data and privacy', items: [
      { id: 'where', q: 'Where are my notes and cards stored?', a: 'In your profile\'s folder, by default Documents/Engram/&lt;profile name&gt;. Notes are .md files, and cards and history are in a database in a hidden .engram folder inside it. See <a href="/docs/reference/your-data/">Your data and backups</a>.' },
      { id: 'backup', q: 'How do I back up?', a: 'Close Engram and copy your profile\'s vault folder somewhere safe. That one folder holds everything for the profile. See <a href="/docs/reference/your-data/#back-up">Back up</a>.' },
      { id: 'move', q: 'Can I move Engram to a new computer?', a: 'Yes. Copy the vault folder across, then create a profile on the new computer that points at it. Step-by-step: <a href="/docs/reference/your-data/#move-to-a-new-computer">Move to a new computer</a>.' },
      { id: 'sync', q: 'Does Engram sync between computers?', a: 'No, there is no built-in sync. You can keep a vault in a cloud-synced folder, but only use it on one computer at a time.' },
      { id: 'tracking', q: 'Does Engram collect data about me?', a: 'No. Engram has no analytics or telemetry. Your notes and cards never leave your computer unless you send them to an AI provider yourself. The <a href="/privacy/">privacy policy</a> explains the details, including what the Cloud backup subscription needs.' },
      { id: 'obsidian', q: 'Can I use my Obsidian vault with Engram?', a: 'Yes. Either import it, or create a profile that points at the vault folder and use it in place. Obsidian plugins, Dataview queries and Canvas files don\'t work inside Engram. See <a href="/docs/features/import/#obsidian-vault">Import</a>.' },
    ],
  },
  {
    id: 'faq-billing', title: 'Cloud backup and billing', items: [
      { id: 'what-need', q: 'What do I need for Cloud backup?', a: 'Just an email address and the $5-a-month subscription (first month free). Sign in from Settings, Backup in the app, or from the <a href="/subscription/">Subscription</a> page on this site. It has nothing to do with the AI tutor, which is free either way.' },
      { id: 'include-ai', q: 'Does the $5 have anything to do with the AI tutor?', a: 'No. Cloud backup and the AI tutor are unrelated. The tutor is free whether or not you subscribe to Cloud backup, and if you use an online AI provider for it, any usage charges are between you and that provider.' },
      { id: 'cancel', q: 'How do I cancel?', a: 'Press Manage subscription in Settings, Backup, or on the <a href="/subscription/">Subscription</a> page on this site. It opens Stripe\'s customer portal, where you can cancel. Cloud backup stays unlocked until the end of the period you\'ve paid for.' },
      { id: 'new-computer-sub', q: 'I got a new computer. How do I get my subscription back?', a: 'Open Settings, Backup (or the <a href="/subscription/">Subscription</a> page on this site), enter the same email address and the code it sends you. Your subscription is matched to your email.' },
      { id: 'ai-quiz', q: 'Do AI-written quizzes need a subscription?', a: 'No. They only need an AI provider set up in Settings, Tutor &amp; API key. Built-in quizzes, Explain and the tutor chat itself need no subscription either.' },
    ],
  },
  {
    id: 'faq-study', title: 'Studying', items: [
      { id: 'how-many', q: 'How many new cards will I see each day?', a: 'Up to 20 new cards per deck per day. Reviews of cards you\'ve already started aren\'t limited. The new card limit can\'t be changed in the app yet.' },
      { id: 'missed-days', q: 'What happens if I skip a few days?', a: 'Nothing is lost. The cards that came due while you were away wait for you, and Engram schedules each one again based on how you rate it.' },
      { id: 'anki-progress', q: 'Will my Anki review progress carry over?', a: 'Yes, if Keep scheduling is ticked when you import (it is by default). The conversion is approximate, so the first few reviews may be timed slightly differently.' },
    ],
  },
];
---
<Page title="Support" kicker="Support" heading="Help and support" description="Answers to common questions about Engram, how to get help, and how to report a bug." lead="Find an answer, fix a problem, or get in touch." searchable>
  <div class="not-prose support-top">
    <Search id="support-search" />
    <div class="quick">
      <a class="device quick-card" href="/support/troubleshooting/"><strong>Troubleshooting</strong><span class="muted">Install warnings, the app won't open, missing data, Cloud backup errors.</span></a>
      <a class="device quick-card" href="/docs/"><strong>Docs</strong><span class="muted">How every part of Engram works.</span></a>
      <a class="device quick-card" href="/support/report-a-bug/"><strong>Report a bug</strong><span class="muted">What to include so it can be fixed.</span></a>
    </div>
  </div>

  <h2 id="faq">Frequently asked questions</h2>
  {groups.map((g) => (
    <section aria-labelledby={g.id}>
      <h3 id={g.id}>{g.title}</h3>
      {g.items.map((it) => (
        <details class="faq" id={it.id}>
          <summary>{it.q}</summary>
          <p set:html={it.a} />
        </details>
      ))}
    </section>
  ))}

  <h2 id="contact">Contact</h2>
  <p>Can't find an answer? Email <ContactEmail subject="Engram support" />.</p>
  {!supportEmailSet && <p class="muted">The support address hasn't been set up yet. Until it is, please check the <a href="/support/troubleshooting/">troubleshooting guide</a> and the <a href="/docs/">docs</a>.</p>}
  <p>Engram is a one-person project, so please be patient with replies. If you're reporting a problem, the <a href="/support/report-a-bug/">bug report checklist</a> helps get it fixed faster.</p>
  <p>Please don't send your API keys, passwords or card numbers by email. They're never needed for support.</p>
</Page>

<style>
  .support-top { max-width: 60rem; margin-bottom: 2rem; }
  .quick { display: grid; gap: 1rem; margin-top: 1.25rem; }
  @media (min-width: 48rem) { .quick { grid-template-columns: repeat(3, 1fr); } }
  .quick-card { display: grid; gap: 0.3rem; padding: 1.1rem 1.2rem; text-decoration: none; color: rgb(var(--ink)); }
  .quick-card:hover { border-color: rgb(var(--accent)); }
  .quick-card span { font-size: 0.92rem; }
  .faq { border-bottom: 1px solid rgb(var(--line)); }
  .faq summary { cursor: pointer; padding: 0.85rem 0; font-weight: 600; list-style-position: outside; }
  .faq summary:hover { color: rgb(var(--accent)); }
  .faq p { margin: 0 0 1rem; color: rgb(var(--ink-dim)); }
</style>
