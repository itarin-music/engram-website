---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { latest, PLATFORM_INFO } from '../lib/releases';

import study from '../assets/shots/study-card.png';
import studyCrop from '../assets/shots/study-card-crop.png';
import notes from '../assets/shots/notes.png';
import makeCard from '../assets/shots/make-card.png';
import quiz from '../assets/shots/quiz.png';
import explain from '../assets/shots/explain.png';
import code from '../assets/shots/code.png';
import chat from '../assets/shots/chat.png';
import timers from '../assets/shots/timers.png';
import importReview from '../assets/shots/import-review.png';
import flipCobalt from '../assets/shots/pack-flip-cobalt.png';
import modernLight from '../assets/shots/pack-modern-light.png';

const features = [
  {
    id: 'notes', kicker: '01 / Notes', title: 'Notes that stay yours',
    body: 'Write in markdown, organise with folders, and link ideas with [[wikilinks]] and backlinks. Every note is a plain file in a folder on your computer, so you can open it in any editor, or point Engram at an Obsidian vault you already have.',
    img: notes, alt: 'The Notes section with a folder tree, a markdown note in split editor and preview view, and a links and backlinks panel',
    link: '/docs/features/notes/',
  },
  {
    id: 'cards', kicker: '02 / Cards', title: 'Turn any sentence into a flashcard',
    body: 'Select a phrase in a note and press Make card. Switch to cloze and Engram hides your selection inside its sentence. Basic, reversed and cloze cards, nested decks, tags and a live preview.',
    img: makeCard, alt: 'The Make card dialog creating a cloze card from selected text, with a preview of the front and back',
    link: '/docs/features/decks-and-cards/',
  },
  {
    id: 'study', kicker: '03 / Study', title: 'Review just before you forget',
    body: 'Rate each card Again, Hard, Good or Easy and Engram schedules the next review with FSRS, a modern spaced repetition method. Keyboard-first: Space, 1 to 4, and Z to undo.',
    img: study, alt: 'A study session showing a Japanese card, its answer, and the four rating buttons with their next review times',
    link: '/docs/features/study/',
  },
  {
    id: 'quizzes', kicker: '04 / Quizzes', title: 'Quizzes built from your own material',
    body: 'Multiple choice and short answer questions generated from a deck, a note or pasted text. The built-in generator works offline. Short answers forgive small typos, and missed questions become cards in one click.',
    img: quiz, alt: 'A multiple choice quiz question about JavaScript with the correct answer highlighted and an explanation',
    link: '/docs/features/quizzes/',
  },
  {
    id: 'explain', kicker: '05 / Explain', title: 'A plainer version of any note, offline',
    body: 'Explain picks out a note’s key sentences, key terms and a rough reading level, right on your computer. Free, with no AI provider and no internet needed.',
    img: explain, alt: 'The Explain window with a reading level badge, a short summary of the note and its key terms',
    link: '/docs/features/explain/',
  },
  {
    id: 'code', kicker: '06 / Code', title: 'Practise code without leaving your notes',
    body: 'A safe sandbox for JavaScript, TypeScript, HTML and CSS, with 12 exercises from FizzBuzz to async retries. Check my solution runs the tests, hints come one at a time, and your progress is saved.',
    img: code, alt: 'The Code section with an exercise open in the editor and passing test results below',
    link: '/docs/features/code/',
  },
  {
    id: 'tutor', kicker: '07 / Tutor', title: 'An AI tutor that reads your notes',
    body: 'Ask about a note, get quizzed, practise a language or talk through code. Bring your own AI provider, or run a free local model with LM Studio or Ollama. Optional paid add-on, first month free.',
    img: chat, alt: 'The tutor chat in Japanese mode explaining the difference between the particles wa and ga',
    caption: 'The reply in this screenshot comes from a test model, not a real AI service.',
    link: '/docs/features/tutor/',
  },
  {
    id: 'timers', kicker: '08 / Timers', title: 'Focus timers with an honest log',
    body: 'Pomodoro, countdown and a count-up study clock. Timers keep running while you work elsewhere in the app, and every session is logged so you can see how long you really studied.',
    img: timers, alt: 'The Timers section with a Pomodoro timer, its settings and a list of recent sessions',
    link: '/docs/features/timers/',
  },
  {
    id: 'import', kicker: '09 / Import', title: 'Bring your Obsidian vault and Anki decks',
    body: 'Import an Obsidian vault, Anki decks with their review progress, a folder of markdown, or a CSV of cards. You see a full preview first, and nothing you already have is ever overwritten.',
    img: importReview, alt: 'The Import preview for an Obsidian vault listing what will be added and what will not carry over',
    link: '/docs/features/import/',
  },
];

const downloadLabel = latest ? `Download v${latest.version}` : 'Download';
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="kicker">Study system / free and local-first</span>
        <h1>Learn things, and actually keep them.</h1>
        <p class="serif-note">Engram, by Itarin</p>
        <p class="lead">
          Engram is a study app for your computer. Write notes, turn the important parts into flashcards,
          and review each one just before you would forget it. Quiz yourself, practise code and time your sessions,
          all in one place.
        </p>
        <p class="who">
          For students, language learners, self-taught programmers and anyone preparing for an exam.
          It's free, needs no account, and your notes stay as plain files on your own computer.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="/download/">{downloadLabel}</a>
          <a class="btn btn-lg" href="/docs/">Read the docs</a>
          <a class="btn btn-lg" href="/support/">Get support</a>
        </div>
        <p class="platforms muted">
          {PLATFORM_INFO.windows.name}, {PLATFORM_INFO.macos.name} and {PLATFORM_INFO.linux.name}
          {latest ? null : <> · <span class="lcd">installers coming soon</span></>}
        </p>
      </div>
      <div class="hero-shot">
        <Shot src={studyCrop} alt="Engram's Study screen in the default Modern Dark theme, reviewing a Japanese flashcard with Again, Hard, Good and Easy buttons" priority sizes="(min-width: 60rem) 36rem, 100vw" />
      </div>
    </div>
  </section>

  <section class="section why" aria-labelledby="why-title">
    <div class="wrap">
      <h2 id="why-title" class="sr-only">Why Engram</h2>
      <ul class="why-grid">
        <li class="device card"><h3>Free, for real</h3><p>Notes, flashcards, spaced repetition, quizzes, imports, code practice, timers and themes cost nothing, with no trial and no limits.</p></li>
        <li class="device card"><h3>Your files, your computer</h3><p>Notes are ordinary markdown files. Cards live in a database inside the same folder. Back it all up by copying one folder.</p></li>
        <li class="device card"><h3>No account, no tracking</h3><p>No sign-up, no ads, no analytics. Engram only goes online for the optional AI tutor and the services you choose to connect.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <span class="kicker">What's inside</span>
      <h2 id="features-title">Everything you need to study, in one app</h2>
      <p class="muted section-lead">Every screenshot on this page is taken from the Engram app itself.</p>
      <div class="features">
        {features.map((f, i) => (
          <article class:list={['feature', { flip: i % 2 === 1 }]} id={f.id} aria-labelledby={`f-${f.id}`}>
            <div class="feature-copy">
              <span class="kicker">{f.kicker}</span>
              <h3 id={`f-${f.id}`}>{f.title}</h3>
              <p>{f.body}</p>
              <a href={f.link}>Learn about {f.kicker.split('/ ')[1]}</a>
            </div>
            <Shot src={f.img} alt={f.alt} caption={(f as { caption?: string }).caption} sizes="(min-width: 60rem) 40rem, 100vw" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="themes-title">
    <div class="wrap">
      <span class="kicker">10 / Themes</span>
      <h2 id="themes-title">Clean and modern, or proudly Y2K</h2>
      <p class="muted section-lead">Seven theme packs, custom colours and backgrounds, and a theme editor that won't let you save anything hard to read. Reduce effects gives you a flat, still interface in one click.</p>
      <div class="theme-grid">
        <Shot src={modernLight} alt="The Notes screen in the Modern Light theme" caption="Modern Light" sizes="(min-width: 48rem) 34rem, 100vw" />
        <Shot src={flipCobalt} alt="The Notes screen in the retro Flip Cobalt theme, with deep blue glass panels and uppercase headings" caption="Flip Cobalt" sizes="(min-width: 48rem) 34rem, 100vw" />
      </div>
      <p><a href="/docs/features/themes/">About themes and appearance</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="price-title">
    <div class="wrap">
      <div class="device price">
        <div>
          <span class="kicker">Pricing</span>
          <h2 id="price-title">Free. One optional add-on.</h2>
          <p>Everything in Engram is free to use, forever. The only paid part is the <strong>AI tutor chat</strong>: <strong>$5 a month, with the first month free</strong>. It covers the sign-in and billing that unlock it. You still bring your own AI provider, or a free local model.</p>
          <p class="muted">AI-written quizzes and the offline Explain summaries are free and don't need the add-on.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href="/download/">Get Engram</a>
          <a class="btn" href="/docs/features/tutor/">About the tutor</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 3rem 0 2rem; }
  @media (min-width: 60rem) { .hero { padding: 4.5rem 0 3rem; } }
  .hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 60rem) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); } }
  .hero-copy .kicker { display: block; margin-bottom: 1rem; }
  .hero h1 { max-width: 16ch; margin-bottom: 0.3rem; }
  .hero .serif-note { font-size: 1.4rem; margin-bottom: 1.2rem; }
  .hero .lead { font-size: 1.15rem; max-width: 36rem; }
  .hero .who { color: rgb(var(--ink-dim)); max-width: 36rem; margin-bottom: 1.6rem; }
  .platforms { margin-top: 1rem; font-size: 0.92rem; }
  .hero-shot :global(figure) { margin: 0; }

  .why { padding-top: 1rem; }
  .why-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .why-grid { grid-template-columns: repeat(3, 1fr); } }

  .section-lead { max-width: 44rem; margin-bottom: 2.5rem; }
  .features { display: grid; gap: 3.5rem; }
  .feature { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 60rem) {
    .feature { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 3rem; }
    .feature.flip .feature-copy { order: 2; }
  }
  .feature-copy .kicker { display: block; margin-bottom: 0.6rem; }
  .feature-copy h3 { font-size: 1.45rem; }
  .feature :global(figure) { margin: 0; }

  .theme-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .theme-grid { grid-template-columns: 1fr 1fr; } }

  .price { padding: 2rem; display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 60rem) { .price { grid-template-columns: 1fr auto; padding: 2.5rem; } }
  .price p { max-width: 44rem; }
</style>
