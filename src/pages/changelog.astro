---
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { releases, formatDate, releasePageUrl, assetsFor, assetLabel, assetUrl, formatSize, PLATFORMS_ORDER, PLATFORM_INFO, USING_SAMPLE } from '../lib/releases';

// Release notes come from the app's CHANGELOG.md via the release manifest (trusted content).
const html = (md: string) => marked.parse(md, { async: false }) as string;
---
<Base title="Changelog" description="Release notes for every version of Engram, newest first.">
  <div class="wrap">
    <header class="page-head">
      <span class="kicker">Changelog</span>
      <h1>What's new in Engram</h1>
      <p class="lead">Release notes for every version, newest first.</p>
      {USING_SAMPLE && <p class="callout callout-warn"><strong>Sample data</strong>This build uses fake sample releases for testing.</p>}
    </header>

    {releases.length === 0 ? (
      <div class="device empty">
        <span class="lcd">Coming soon</span>
        <h2>No releases yet</h2>
        <p class="muted">Engram's first public release hasn't been published. When it is, its release notes will appear here, and on the <a href="/download/">Download page</a>.</p>
      </div>
    ) : (
      <ol class="releases">
        {releases.map((r, i) => (
          <li>
            <article class="release" id={r.tag} aria-labelledby={`h-${r.tag}`}>
              <header>
                <h2 id={`h-${r.tag}`}>Version {r.version} {i === 0 && <span class="lcd">Latest</span>}</h2>
                <p class="muted"><time datetime={r.date}>{formatDate(r.date)}</time> · <a href={releasePageUrl(r)}>Release files</a></p>
              </header>
              <div class="prose" set:html={html(r.notes)} />
              <details class="files">
                <summary>Downloads for {r.version}</summary>
                <ul>
                  {PLATFORMS_ORDER.flatMap((p) => assetsFor(r, p).map((a) => (
                    <li><a href={assetUrl(r, a)}>{PLATFORM_INFO[p].name}: {assetLabel(a).title}</a> <span class="muted">({formatSize(a.size)})</span></li>
                  )))}
                </ul>
              </details>
            </article>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>

<style>
  .empty { padding: 2rem; max-width: 44rem; display: grid; gap: 0.6rem; justify-items: start; }
  .empty h2 { margin: 0.3rem 0 0; }
  .releases { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; max-width: 50rem; }
  .release { border-left: 3px solid rgb(var(--accent) / 0.6); padding-left: 1.25rem; }
  .release h2 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 0.2rem; }
  .release header p { font-size: 0.92rem; }
  .files { margin-top: 0.5rem; }
  .files summary { cursor: pointer; font-weight: 600; padding: 0.4rem 0; }
  .files ul { padding-left: 1.3rem; }
</style>
