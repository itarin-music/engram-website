---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="wrap nf">
    <span class="lcd">Error 404</span>
    <h1>This page doesn't exist</h1>
    <p class="serif-note">Not even in your long-term memory.</p>
    <p class="muted">The link may be old, or the address may have a typo. Try one of these instead:</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn" href="/download/">Download</a>
      <a class="btn" href="/docs/">Docs</a>
      <a class="btn" href="/support/">Support</a>
    </div>
  </div>
</Base>

<style>
  .nf { padding: 5rem var(--gutter) 3rem; max-width: 44rem; }
  .nf h1 { margin-top: 1rem; }
  .nf .serif-note { margin-bottom: 1.2rem; }
</style>
