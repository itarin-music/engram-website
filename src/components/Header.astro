---
import { NAV } from '../config/site';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <Wordmark />
    <button class="btn nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      <span>Menu</span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main" data-open="false">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu. Without JavaScript the menu is simply always visible.
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    btn.hidden = false;
    const set = (open: boolean) => { nav.dataset.open = String(open); btn.setAttribute('aria-expanded', String(open)); };
    btn.addEventListener('click', () => set(nav.dataset.open !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.dataset.open === 'true') { set(false); btn.focus(); } });
  }
</script>
