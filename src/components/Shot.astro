---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Eager-load the image (only for the first, above-the-fold screenshot). */
  priority?: boolean;
  sizes?: string;
  class?: string;
}
const { src, alt, caption, priority = false, sizes = '(min-width: 72rem) 68rem, 100vw', class: cls } = Astro.props;
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width);
---
<figure class:list={['shot-figure', cls]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    class="shot"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
